%% C4 Level 3 - Components: LLM Gateway (PROPOSED architecture, not implemented)
%% Source: docs/02-enterprise-ai-architecture/llm-gateway-model-serving.md section 2
C4Component
  title Component Diagram - LLM Gateway (Proposed)

  System_Ext(apps, "Tenant Applications", "Callers with OIDC token or project credential")
  System_Ext(entra, "Microsoft Entra ID", "Issues tokens; publishes JWKS")
  System_Ext(bedrock, "Amazon Bedrock", "Managed model inference")
  Container_Ext(vllm, "Self-Hosted Model Serving", "vLLM on EKS (optional)", "OpenAI-compatible API")
  Container_Ext(configdist, "Config Distribution", "Control plane", "Signed config and policy snapshots")
  ContainerDb_Ext(ratelimit, "Rate-Limit Store", "Redis-compatible (assumed)", "Per-tenant counters")
  Container_Ext(usage, "Usage Pipeline", "Kinesis or SQS (open)", "Durable usage events")
  Container_Ext(otel, "Observability Pipeline", "OpenTelemetry collector", "Traces and metrics")

  Container_Boundary(gw, "LLM Gateway") {
    Component(handler, "API Handler", "HTTP service", "Inference, embeddings, streaming; validation and size limits")
    Component(authn, "Authenticator", "JWT validation", "Validates tokens via cached JWKS; checks revocation list")
    Component(pep, "Policy Enforcement Point", "Embedded PDP (engine open)", "Tenant, project, role, entitlement, classification checks")
    Component(limiter, "Rate Limiter and Quota Enforcer", "Library", "Request, token and concurrency limits")
    Component(guard, "Guardrail Hooks", "Plugin interface", "Advisory input and output checks; never grants permission")
    Component(router, "Router", "Library", "Alias resolution, failover, circuit breakers, timeouts, retries")
    Component(bedrockad, "Bedrock Adapter", "AWS SDK", "Converse / InvokeModel calls")
    Component(oaiad, "OpenAI-Compatible Adapter", "HTTP client", "Calls vLLM endpoints")
    Component(meter, "Usage Emitter", "Async producer", "Tokens, cost estimate, error class per request")
    Component(telemetry, "Telemetry", "OpenTelemetry SDK", "Spans, metrics, trace ID propagation")
    Component(cache, "Config Cache", "In-memory + signature check", "Holds last-known-good snapshot with staleness cap")
  }

  Rel(apps, handler, "Sends requests", "HTTPS")
  Rel(handler, authn, "Authenticates request", "In-process")
  Rel(authn, entra, "Refreshes signing keys", "JWKS over HTTPS")
  Rel(handler, pep, "Authorizes request", "In-process")
  Rel(handler, limiter, "Checks limits", "In-process")
  Rel(limiter, ratelimit, "Reads and increments counters", "Redis protocol")
  Rel(handler, guard, "Runs input and output checks", "In-process")
  Rel(handler, router, "Routes allowed request", "In-process")
  Rel(router, bedrockad, "Selects managed deployment", "In-process")
  Rel(router, oaiad, "Selects self-hosted deployment", "In-process")
  Rel(bedrockad, bedrock, "Invokes model", "AWS SDK via PrivateLink")
  Rel(oaiad, vllm, "Invokes model", "HTTP")
  Rel(handler, meter, "Records usage on completion", "Async")
  Rel(meter, usage, "Publishes usage events", "Async, buffered")
  Rel(handler, telemetry, "Records spans", "In-process")
  Rel(telemetry, otel, "Exports telemetry", "OTLP")
  Rel(configdist, cache, "Delivers signed snapshots", "Pull / notify")
  Rel(authn, cache, "Reads revocation list", "In-process")
  Rel(pep, cache, "Reads policy bundle and entitlements", "In-process")
  Rel(limiter, cache, "Reads quota configuration", "In-process")
  Rel(router, cache, "Reads model catalog and routes", "In-process")

  UpdateLayoutConfig($c4ShapeInRow="4", $c4BoundaryInRow="1")
