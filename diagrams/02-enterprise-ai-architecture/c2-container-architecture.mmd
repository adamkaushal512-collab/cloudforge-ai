%% C4 Level 2 - Containers: CloudForge AI (PROPOSED architecture, not implemented)
%% Source: docs/02-enterprise-ai-architecture/architecture-overview.md section 5
C4Container
  title Container Diagram - CloudForge AI Platform (Proposed)

  Person(dev, "AI Developer / ML Engineer", "Tenant team member")
  Person(approver, "Approver", "Security or business owner")
  System_Ext(apps, "Tenant Applications", "Team-owned AI applications")
  System_Ext(entra, "Microsoft Entra ID", "OIDC identity provider")
  System_Ext(bedrock, "Amazon Bedrock", "Managed model inference")
  System_Ext(sources, "Enterprise Data Sources", "Content with source ACLs")
  System_Ext(opsys, "Operational Systems", "MCP tool targets")

  System_Boundary(platform, "CloudForge AI Platform") {
    Boundary(cp, "Control Plane", "management") {
      Container(portal, "Developer Portal and CLI", "Web app, CLI", "Self-service onboarding, catalog, usage views")
      Container(cpapi, "Control-Plane API", "Service on EKS", "Tenants, projects, credentials, entitlements, quotas, catalog, policy, registries")
      Container(approval, "Approval Service", "Service on EKS", "Sensitive-operation requests, decisions, timeouts")
      Container(configdist, "Config Distribution", "Service + S3", "Publishes KMS-signed config and policy snapshots")
      ContainerDb(cpdb, "Control-Plane Database", "Aurora PostgreSQL (assumed)", "Authoritative tenant and config state")
    }
    Boundary(dp, "Data Plane", "execution") {
      Container(gateway, "LLM Gateway", "Custom service; LiteLLM candidate only", "AuthN/AuthZ, quotas, routing, metering")
      ContainerDb(ratelimit, "Rate-Limit Store", "ElastiCache Redis-compatible (assumed)", "Per-tenant counters")
      Container(vllm, "Self-Hosted Model Serving", "vLLM on EKS GPU nodes (optional)", "Open-weight models")
      Container(agents, "Agent Runtime", "LangGraph workers on EKS", "Agent graphs, checkpoints, approval interrupts")
      Container(mcp, "MCP Broker", "Service on EKS", "Governed tool invocation and credential minting")
      Container(workflows, "Platform Workflow Engine", "Temporal (candidate)", "Ingestion, re-sync, promotion, approval timers")
      Container(ingest, "RAG Ingestion Workers", "Workers on EKS", "Connectors, chunking, ACL capture")
      Container(retrieval, "Retrieval Service", "Service on EKS", "ACL-filtered retrieval with citations")
      ContainerDb(opensearch, "Vector / Search Store", "Amazon OpenSearch Service", "Per-tenant indexes")
      Container(mlflow, "MLOps Services", "MLflow on EKS + S3", "Experiment tracking, model registry")
      Container(mlwork, "Training and Serving Workloads", "EKS jobs and deployments", "Tenant training, batch and online scoring")
    }
    Boundary(shared, "Shared Services", "cross-cutting") {
      Container(usage, "Usage Pipeline", "Kinesis or SQS (open) + usage DB", "Durable usage events and cost estimates")
      Container(otel, "Observability Pipeline", "OpenTelemetry collector + backend (open)", "Traces, metrics, logs")
      ContainerDb(audit, "Audit Store", "S3 Object Lock (assumed)", "Append-only, tamper-evident audit records")
      Container(secrets, "Secrets and Keys", "Secrets Manager, KMS", "Secrets and encryption keys")
    }
  }

